{
  "name": "@estiva-app/ui",
  "version": "0.28.0",
  "description": "Estiva's design tokens (the contract) and a small set of primitives (a convenience) for every Estiva app.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "stories",
    "registry.json",
    "skill",
    "tailwind-preset.js",
    "tokens.css",
    "base.css",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./eslint": {
      "types": "./dist/eslint/index.d.ts",
      "default": "./dist/eslint/index.js"
    },
    "./gates": {
      "types": "./dist/gates/index.d.ts",
      "default": "./dist/gates/index.js"
    },
    "./registry": {
      "types": "./dist/registry/index.d.ts",
      "default": "./dist/registry/index.js"
    },
    "./registry.json": "./registry.json",
    "./tailwind-preset": "./tailwind-preset.js",
    "./tokens.css": "./tokens.css",
    "./package.json": "./package.json",
    "./base.css": "./base.css"
  },
  "bin": {
    "create-estiva-app": "dist/gates/create-app.js",
    "estiva-gates": "dist/gates/cli.js",
    "estiva-ui": "dist/registry/cli.js"
  },
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "storybook": "storybook dev -p 6008 --no-open",
    "build-storybook": "storybook build",
    "pretest": "node build.mjs",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:a11y": "vitest run --project storybook-signal --project storybook-ship",
    "typecheck": "tsc --noEmit",
    "prelint": "node build.mjs",
    "lint": "eslint .",
    "prelint:rules": "node build.mjs",
    "lint:rules": "eslint --config eslint.gates.config.js .",
    "postlint:rules": "node dist/gates/cli.js count --repo estiva-ui --package",
    "pregates:status": "node build.mjs",
    "gates:status": "node dist/gates/cli.js status",
    "pregates:compare": "node build.mjs",
    "gates:compare": "node scripts/gates-compare.mjs",
    "preregistry": "node build.mjs",
    "registry": "node dist/registry/cli.js build",
    "preregistry:check": "node build.mjs",
    "registry:check": "node dist/registry/cli.js check",
    "skill:check": "vitest run --project unit src/registry/skill.test.ts",
    "preui:find": "node build.mjs",
    "ui:find": "node dist/registry/cli.js find",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@tabler/icons-react": "^3.41.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.0",
    "eslint": ">=9",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "typescript-eslint": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "eslint-plugin-better-tailwindcss": {
      "optional": true
    },
    "typescript-eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.5.10",
    "@tabler/icons-react": "^3.41.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "autoprefixer": "^10.4.27",
    "esbuild": "^0.28.0",
    "eslint": "^10.10.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "postcss": "^8.5.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.5.10",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/estiva-app/estiva-ui.git"
  }
}
